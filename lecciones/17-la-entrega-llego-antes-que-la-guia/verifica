#!/usr/bin/env bash
# Comprueba la lección 17: la paquetería avisa que entregó la 4002 ANTES de que la bodega mande su embarque.
# El router no la rechaza ni la manda a destiempo: la ESTACIONA (contesta 202 y no sale nada a los destinos).
# Cuando el embarque llega y cada canal lo acepta, el barrido suelta la entrega: la API y el ERP quedan en
# ENTREGADO con la guía, el 214 llega al socio, y cada entrega salió UNA vez (un intento por canal, aunque el
# barrido corra de nuevo).
# Uso: ./verifica [mio|solucion]   (por omisión, mio). Necesita el ambiente de la 00 arriba.
set -uo pipefail
cd "$(dirname "$0")"
RAIZ="$(cd ../.. && pwd)"
DONDE="${1:-mio}"
[ -d "$DONDE" ] || { echo "❌ No existe $DONDE/. Copia inicio/ a mio/ primero."; exit 1; }
ok=0; si() { echo "✅ $1"; }; no() { echo "❌ $1"; ok=1; }
INFRA() { docker compose -f "$RAIZ/infra/compose.yaml" "$@"; }
SQL() { INFRA exec -T erp mariadb -uintegracion -p"${ERP_CLAVE:-practica}" erp -N -e "$1" 2>/dev/null; }
EST() { INFRA exec -T estado psql -U router -d estado -tAF $'\t' -c "$1" 2>/dev/null; }
SOCIO() { INFRA exec -T socio-sftp sh -c "$1" 2>/dev/null; }
SERV() { DONDE="$DONDE" docker compose -f compose.yaml "$@"; }
apagar() { SERV down >/dev/null 2>&1; }
CAMPO() { curl -s "localhost:8081/pedidos/$1" | python3 -c "import sys,json; print(json.load(sys.stdin).get('$2'))" 2>/dev/null; }
DATOS="$RAIZ/datos"
# Cuántas operaciones de una orden y un momento ya tienen desenlace (ni pendientes ni estacionadas)
TERMINADAS() { EST "SELECT COUNT(*) FROM operacion WHERE orden='$1' AND momento='$2' AND estado NOT IN ('pendiente','estacionada')"; }
ESTACIONADAS() { EST "SELECT COUNT(*) FROM operacion WHERE orden='$1' AND momento='$2' AND estado = 'estacionada'"; }
esperar_est() { for i in $(seq 1 20); do [ "$(ESTACIONADAS "$1" "$2")" -ge "$3" ] && return 0; sleep 1; done; return 1; }
esperar_ops() { for i in $(seq 1 40); do [ "$(TERMINADAS "$1" "$2")" -ge "$3" ] && return 0; sleep 2; done; return 1; }

# Todo empieza limpio: los destinos y la base de estado
INFRA restart api-pedidos >/dev/null 2>&1
INFRA up -d --wait api-pedidos erp estado >/dev/null 2>&1 || { no "El ambiente no levantó: ¿corriste la 00?"; exit 1; }
SQL "DELETE FROM entrega; DELETE FROM embarque; DELETE FROM pedido_detalle; DELETE FROM pedido_cabecera;" || { no "No pude hablar con el ERP"; exit 1; }
[ "$(EST "SELECT COUNT(*) FROM information_schema.columns WHERE table_name='operacion' AND column_name='correlacion'")" = "1" ] \
  && [ "$(EST "SELECT COUNT(*) FROM pg_class WHERE relname='numero_control_seq'")" = "1" ] \
  || { no "A la base de estado le falta la secuencia numero_control_seq o la columna correlacion. Recréala: docker compose -f infra/compose.yaml up -d --wait --force-recreate -V estado"; exit 1; }
EST "TRUNCATE intento, operacion, orden RESTART IDENTITY CASCADE" >/dev/null || { no "No pude limpiar la base de estado"; exit 1; }
SOCIO "rm -f /home/socio/entrada/*" || { no "No pude hablar con el SFTP del socio"; exit 1; }
(cd "$DONDE/int-edi" && "$RAIZ/herramientas/confiar-en-socio" >/dev/null) || { no "No pude anotar la llave del socio"; exit 1; }
[ "$DONDE" = "mio" ] || trap 'rm -f "$DONDE/int-edi/known_hosts"' EXIT
rm -rf buzon; mkdir -p buzon

apagar
if curl -s -o /dev/null --max-time 2 localhost:8080; then
  no "El puerto 8080 está ocupado: apaga lo que dejaste corriendo (Ctrl+C o «docker compose … down») y vuelve a intentar"; exit 1
fi
SERV up -d >/dev/null 2>&1 || { no "No pude levantar los servicios de la lección"; apagar; exit 1; }
RUTAS="barrido-http|barrido|decidir|webhook-paqueteria|int-rest-entrega|int-bd-entrega|int-edi-entrega|orden-router|embarque-router|hilo|contestar-y-repartir|no-existe|canales|cargar-orden|guardar-orden|guardar-momento|repartir|enviar|int-rest|int-bd|int-edi|int-rest-embarque|int-bd-embarque|int-edi-embarque|sondeo-bodega"
LISTOS() { SERV logs 2>/dev/null | grep -cE "Started ($RUTAS) "; }
for i in $(seq 1 90); do [ "$(LISTOS)" -ge 25 ] && break; sleep 2; done
[ "$(LISTOS)" -ge 25 ] && si "Arrancaron el router (con su máquina de estados y el barrido), los tres canales y el sondeo" \
  || { no "No arrancaron todas las rutas. Esto dijeron:"; SERV logs 2>/dev/null | grep -E "ERROR|Exception" | head -10; apagar; exit 1; }

# La 4002 se crea, como en la 15
c=$(curl -s -o /dev/null -w "%{http_code}" --max-time 10 -XPOST localhost:8080/ordenes -H 'Content-Type: application/json' -d @"$DATOS/ordenes/tramo-2/orden-4002.json")
esperar_ops 4002 creada 3
[ "$c" = "202" ] && [ "$(CAMPO 4002 estatus)" = "CREADO" ] && [ "$(SQL "SELECT estatus FROM pedido_cabecera WHERE pedido='4002'")" = "REGISTRADO" ] \
  && si "La 4002 está creada: CREADO en la API y REGISTRADO en el ERP" || { no "La 4002 no se creó; sin eso no hay nada que estacionar"; apagar; exit 1; }

# La paquetería avisa la entrega ANTES de que llegue el embarque
# (desde aquí se cuentan los 201 de la API: sus registros guardan también los de corridas anteriores)
T0=$(date -u +%Y-%m-%dT%H:%M:%SZ)
R=$(curl -s -w "\n%{http_code}" --max-time 10 -XPOST localhost:8080/webhooks/paqueteria -H 'Content-Type: application/json' -d @"$DATOS/webhooks/entrega-4002.json")
[ "$(echo "$R" | tail -1)" = "202" ] && si "La entrega de la 4002 llegó antes que su embarque y el router contestó 202 «recibida»" \
  || no "Esperaba 202 del webhook y el router contestó: $(echo "$R" | tr '\n' ' ')"
esperar_est 4002 entregada 3
OPS=$(EST "SELECT string_agg(canal || '=' || estado, ' ' ORDER BY canal) FROM operacion WHERE orden='4002' AND momento='entregada'")
INT=$(EST "SELECT COUNT(*) FROM intento i JOIN operacion p ON p.id = i.operacion WHERE p.orden='4002' AND p.momento='entregada'")
[ "$OPS" = "bd=estacionada edi=estacionada rest=estacionada" ] && [ "$INT" = "0" ] \
  && si "Estado: las tres operaciones de la entrega quedaron estacionadas, sin ningún intento" \
  || no "Estado: esperaba las tres estacionadas y sin intentos; hay «${OPS:-nada}» y $INT intentos"
[ "$(CAMPO 4002 estatus)" = "CREADO" ] && [ "$(SQL "SELECT COUNT(*) FROM entrega WHERE pedido='4002'")" = "0" ] \
  && [ -z "$(SOCIO 'ls /home/socio/entrada/214-4002.edi' 2>/dev/null)" ] \
  && si "Destinos: a nadie le llegó la entrega a destiempo (la API sigue en CREADO, el ERP sin entrega, sin 214)" \
  || no "Destinos: la entrega salió antes que el embarque (API «$(CAMPO 4002 estatus)»)"

# Llega el embarque: cada canal lo acepta y el barrido suelta la entrega que lo esperaba
python3 -c "import json,sys; e=json.load(open(sys.argv[1])); json.dump({'lote':'9002','bodega':'B-NORTE','embarques':[e]}, open('buzon/lote-bodega-9002.json','w'))" "$DATOS/embarques/embarque-4002.json"
esperar_ops 4002 embarcada 3
esperar_ops 4002 entregada 3
# Y un barrido pedido a mano, después: lo que ya salió no vuelve a salir
cb=$(curl -s -o /dev/null -w "%{http_code}" --max-time 10 -XPOST localhost:8080/barrido)
sleep 3
OPS=$(EST "SELECT string_agg(canal || '=' || estado, ' ' ORDER BY canal) FROM operacion WHERE orden='4002' AND momento IN ('embarcada','entregada') GROUP BY momento ORDER BY momento")
[ "$(echo $OPS)" = "bd=aceptada edi=aceptada rest=aceptada bd=aceptada edi=aceptada rest=aceptada" ] \
  && [ "$(EST "SELECT momento FROM orden WHERE orden='4002'")" = "entregada" ] \
  && si "Estado: llegó el embarque, el barrido soltó la entrega y los seis quedaron aceptados; la orden va en «entregada»" \
  || no "Estado: después del embarque, embarque y entrega quedaron «$(echo ${OPS:-nada})»"
[ "$(CAMPO 4002 estatus)" = "ENTREGADO" ] && [ "$(CAMPO 4002 guia)" = "PAQX770004002" ] \
  && si "API: la 4002 está ENTREGADO, con su guía" || no "API: la 4002 está «$(CAMPO 4002 estatus)»"
FILA=$(SQL "SELECT c.estatus, e.guia FROM pedido_cabecera c JOIN entrega e USING (pedido) WHERE pedido='4002'")
[ "$FILA" = "$(printf 'ENTREGADO\tPAQX770004002')" ] && si "ERP: la 4002 está ENTREGADO y su fila de entrega tiene la guía" \
  || no "ERP: esperaba «ENTREGADO PAQX770004002» y tiene «${FILA:-nada}»"
mkdir -p "$DONDE/salida"; rm -f "$DONDE/salida/214-4002.edi"
SOCIO "cat /home/socio/entrada/214-4002.edi" > "$DONDE/salida/214-4002.edi"
if [ -s "$DONDE/salida/214-4002.edi" ] && "$RAIZ/herramientas/leer-x12" "$DONDE/salida/214-4002.edi" >/dev/null 2>&1; then
  si "Socio: el 214 de la 4002 está en su SFTP y el lector X12 no le encontró fallas"
else
  no "Socio: el 214 de la 4002 no está o no pasa el lector (hay: $(SOCIO 'ls /home/socio/entrada' | tr '\n' ' '))"
fi
INT=$(EST "SELECT COUNT(*) FROM intento i JOIN operacion p ON p.id = i.operacion WHERE p.orden='4002' AND p.momento='entregada'")
API201=$(INFRA logs --since "$T0" api-pedidos 2>/dev/null)
N201=$(printf '%s\n' "$API201" | grep -c "201 evento llave=orden-4002-entregada ")
[ "$cb" = "200" ] && [ "$INT" = "3" ] && [ "$N201" = "1" ] \
  && si "Una sola vez: un intento por canal para la entrega y un solo 201 en la API, aunque el barrido corrió otra vez a mano" \
  || no "Esperaba el barrido a mano en 200, 3 intentos de la entrega y un 201 en la API; hay barrido «$cb», $INT intentos y $N201 201"
apagar
exit $ok
