#!/usr/bin/env bash
# Comprueba la lección 27: el rastro no muestra datos personales y sigue sirviendo para diagnosticar.
#   1. El mapeo mappings/rastro/mascara/v1 pasa sus casos dorados.
#   2. Llega la 4008, con el nombre, el correo, el teléfono y la calle de una clienta de prueba. Ninguno de los cuatro
#      aparece en el rastro (payload, intentos, acuses, avisos, conflictos), en GET /ordenes/4008/recorrido ni en
#      los logs. Control positivo: la orden guardada sí los tiene (el router la necesita entera para reenviarla).
#   3. Lo tapado deja ver lo que sirve: la tienda, los renglones, el dominio del correo, los dos últimos del teléfono.
# Uso: ./verifica [mio|solucion]   (por omisión, mio). Necesita el ambiente de la 00 arriba.
set -uo pipefail
cd "$(dirname "$0")"
RAIZ="$(cd ../.. && pwd)"
DONDE="${1:-mio}"
[ -d "$DONDE" ] || { echo "❌ No existe $DONDE/. Copia inicio/ a mio/ primero."; exit 1; }
hay() { grep "$@" >/dev/null; }   # grep sin -q: con pipefail, -q corta la tubería y da falsos rojos
ok=0; si() { echo "✅ $1"; }; no() { echo "❌ $1"; ok=1; }
INFRA() { docker compose -f "$RAIZ/infra/compose.yaml" "$@"; }
SQL() { INFRA exec -T erp mariadb -uintegracion -p"${ERP_CLAVE:-practica}" erp -N -e "$1" 2>/dev/null; }
EST() { INFRA exec -T estado psql -U router -d estado -tAF $'\t' -c "$1" 2>/dev/null; }
SOCIO() { INFRA exec -T socio-sftp sh -c "$1" 2>/dev/null; }
SERV() { DONDE="$DONDE" docker compose -f compose.yaml "$@"; }
apagar() { SERV down >/dev/null 2>&1; }
CAMPO() { curl -s "localhost:8081/pedidos/$1" | python3 -c "import sys,json; print(json.load(sys.stdin).get('$2'))" 2>/dev/null; }
DATOS="$RAIZ/datos"
# Cuántas operaciones de una orden y un momento ya tienen desenlace (ni pendientes ni estacionadas)
TERMINADAS() { EST "SELECT COUNT(*) FROM operacion WHERE orden='$1' AND momento='$2' AND estado NOT IN ('pendiente','estacionada')"; }
ESTACIONADAS() { EST "SELECT COUNT(*) FROM operacion WHERE orden='$1' AND momento='$2' AND estado = 'estacionada'"; }
esperar_est() { for i in $(seq 1 20); do [ "$(ESTACIONADAS "$1" "$2")" -ge "$3" ] && return 0; sleep 1; done; return 1; }
esperar_ops() { for i in $(seq 1 40); do [ "$(TERMINADAS "$1" "$2")" -ge "$3" ] && return 0; sleep 2; done; return 1; }

# Todo empieza limpio: los destinos y la base de estado
INFRA restart api-pedidos >/dev/null 2>&1
INFRA up -d --wait api-pedidos erp estado >/dev/null 2>&1 || { no "El ambiente no levantó: ¿corriste la 00?"; exit 1; }
SQL "DELETE FROM entrega; DELETE FROM embarque; DELETE FROM pedido_detalle; DELETE FROM pedido_cabecera;" || { no "No pude hablar con el ERP"; exit 1; }
[ "$(EST "SELECT COUNT(*) FROM information_schema.columns WHERE table_name='operacion' AND column_name='correlacion'")" = "1" ] \
  && [ "$(EST "SELECT COUNT(*) FROM pg_class WHERE relname='numero_control_seq'")" = "1" ] \
  || { no "A la base de estado le falta la secuencia numero_control_seq o la columna correlacion. Recréala: docker compose -f infra/compose.yaml up -d --wait --force-recreate -V estado"; exit 1; }
[ "$(EST "SELECT COUNT(*) FROM pg_class WHERE relname IN ('completitud','alerta','payload')")" = "3" ] \
  || { no "A la base de estado le faltan las tablas completitud, alerta o payload (lecciones 25 y 27). Recréala: docker compose -f infra/compose.yaml up -d --wait --force-recreate -V estado"; exit 1; }
trap '[ "$DONDE" = "mio" ] || rm -f "$DONDE/int-edi/known_hosts" "$DONDE/orden-router/known_hosts"' EXIT
EST "DROP VIEW IF EXISTS recorrido" >/dev/null; EST "TRUNCATE acuse, conflicto, intento, payload, operacion, orden RESTART IDENTITY CASCADE" >/dev/null || { no "No pude limpiar la base de estado"; exit 1; }
SOCIO "rm -rf /home/socio/entrada/* /home/socio/salida/* /home/socio/salida/.leidos" || { no "No pude hablar con el SFTP del socio"; exit 1; }
(cd "$DONDE/int-edi" && "$RAIZ/herramientas/confiar-en-socio" >/dev/null) || { no "No pude anotar la llave del socio"; exit 1; }
# El router también entra al SFTP del socio desde la 21: a leer los acuses
(cd "$DONDE/orden-router" && "$RAIZ/herramientas/confiar-en-socio" >/dev/null) || { no "No pude anotar la llave del socio para el router"; exit 1; }
[ "$(INFRA ps --format '{{.Service}} {{.State}}' | awk '$1=="socio-bot"{print $2}')" = "running" ] \
  || { no "No está arriba socio-bot, el sistema del socio que manda los 997: docker compose -f infra/compose.yaml up -d --wait"; exit 1; }
rm -rf buzon; mkdir -p buzon

# 1. Los casos dorados del enmascarado
if "$RAIZ/herramientas/probar-mapeo" "$DONDE/orden-router/mappings/rastro/mascara/v1" >/dev/null 2>&1; then
  si "El mapeo rastro/mascara/v1 pasa sus casos dorados"
else
  no "El mapeo rastro/mascara/v1 no pasa sus casos dorados (corre herramientas/probar-mapeo $DONDE/orden-router/mappings/rastro/mascara/v1)"
fi
apagar
if curl -s -o /dev/null --max-time 2 localhost:8080; then
  no "El puerto 8080 está ocupado: apaga lo que dejaste corriendo (Ctrl+C o «docker compose … down») y vuelve a intentar"; exit 1
fi
SERV up -d >/dev/null 2>&1 || { no "No pude levantar los servicios de la lección"; apagar; exit 1; }
RUTAS="crear-recorrido|recorrido-http|vigilar|juntar|vencidos|rerun|preparar|llamar-canal|sin-respuesta|sondeo-acuses|correlacionar-acuse|intentar|reconocer|recibir-momento|contestar-reconocido|barrido-http|barrido|decidir|webhook-paqueteria|int-rest-entrega|int-bd-entrega|int-edi-entrega|orden-router|embarque-router|hilo|contestar-y-repartir|no-existe|canales|cargar-orden|guardar-orden|guardar-momento|repartir|enviar|int-rest|int-bd|int-edi|int-rest-embarque|int-bd-embarque|int-edi-embarque|sondeo-bodega"
LISTOS() { SERV logs 2>/dev/null | grep -cE "Started ($RUTAS) "; }
for i in $(seq 1 90); do [ "$(LISTOS)" -ge 46 ] && break; sleep 2; done
[ "$(LISTOS)" -ge 46 ] && si "Arrancaron el router (que tapa los datos personales del rastro), los tres canales y el sondeo" \
  || { no "No arrancaron todas las rutas. Esto dijeron:"; SERV logs 2>/dev/null | grep -E "ERROR|Exception" | head -10; apagar; exit 1; }

for i in $(seq 1 15); do [ "$(EST "SELECT COUNT(*) FROM pg_views WHERE viewname='recorrido'")" = "1" ] && break; sleep 1; done
T0=$(date -u +%Y-%m-%dT%H:%M:%SZ)
# 2. Llega la 4008 y se espera a que sus tres canales contesten (y al 997 del socio)
curl -s -o /dev/null --max-time 10 -XPOST localhost:8080/ordenes -H 'Content-Type: application/json' -d @"$DATOS/ordenes/tramo-2/orden-4008.json"
for i in $(seq 1 25); do [ "$(EST "SELECT COUNT(*) FROM operacion WHERE orden='4008' AND estado IN ('aceptada','confirmada')")" = "3" ] \
  && [ "$(EST "SELECT estado FROM operacion WHERE orden='4008' AND canal='edi'")" = "confirmada" ] && break; sleep 1; done
LISTA="$(EST "SELECT COUNT(*) FROM operacion WHERE orden='4008' AND estado IN ('aceptada','confirmada')")"
[ "$LISTA" = "3" ] || no "La 4008 no llegó a sus tres canales ($LISTA de 3): sin eso no hay rastro que revisar"
PERSONALES=("Ana Ejemplo Prueba" "ana.prueba@example.com" "+52 55 0000 0428" "Calle de Ejemplo 28")
RASTRO="SELECT cuerpo FROM payload UNION ALL SELECT CAST(respuesta AS text) FROM intento UNION ALL SELECT CAST(cuerpo AS text) FROM conflicto
  UNION ALL SELECT CAST(errores AS text) FROM acuse UNION ALL SELECT estado || espera FROM alerta"
EN_RASTRO=0; EN_ORDEN=0
for v in "${PERSONALES[@]}"; do
  EN_RASTRO=$(( EN_RASTRO + $(EST "SELECT COUNT(*) FROM ($RASTRO) AS x(t) WHERE strpos(t, '$v') > 0") ))
  EN_ORDEN=$(( EN_ORDEN + $(EST "SELECT COUNT(*) FROM orden WHERE orden='4008' AND strpos(CAST(datos AS text), '$v') > 0") ))
done
[ "$EN_ORDEN" = "4" ] && si "Control: la orden guardada sí tiene los 4 datos personales (la búsqueda encuentra lo que hay)" \
  || no "Control: esperaba los 4 datos personales en la orden guardada y encontré $EN_ORDEN: la búsqueda no está viendo"
[ "$EN_RASTRO" = "0" ] && si "En el rastro de la base (payload, intentos, acuses, avisos, conflictos): 0 datos personales" \
  || no "En el rastro de la base hay $EN_RASTRO apariciones de los datos personales de la 4008"
REC=$(curl -s --max-time 10 localhost:8080/ordenes/4008/recorrido)
EN_REC=0; for v in "${PERSONALES[@]}"; do printf '%s' "$REC" | hay -F "$v" && EN_REC=$((EN_REC+1)); done
printf '%s' "$REC" | hay -F '"orden":"4008"' && [ "$EN_REC" = "0" ] \
  && si "GET /ordenes/4008/recorrido: la orden sí sale, y sin sus datos personales" \
  || no "GET /ordenes/4008/recorrido: $EN_REC de los 4 datos personales a la vista (o la orden no salió)"
LOGS=$( { SERV logs --since "$T0" 2>/dev/null; INFRA logs --since "$T0" api-pedidos erp socio-bot 2>/dev/null; } )
EN_LOG=0; for v in "${PERSONALES[@]}"; do printf '%s\n' "$LOGS" | hay -F "$v" && EN_LOG=$((EN_LOG+1)); done
N4008=$(printf '%s\n' "$LOGS" | grep -c '4008')
[ "$N4008" -gt 0 ] && [ "$EN_LOG" = "0" ] \
  && si "En los logs: la 4008 aparece $N4008 veces y sus datos personales 0" \
  || no "En los logs: la 4008 aparece $N4008 veces y $EN_LOG de sus 4 datos personales están a la vista"
# 3. Lo tapado sigue sirviendo para diagnosticar
D=$(EST "SELECT (CAST(cuerpo AS jsonb) ->> 'tienda') || ' ' || jsonb_array_length(CAST(cuerpo AS jsonb) -> 'renglones') || ' ' || (CAST(cuerpo AS jsonb) -> 'cliente' ->> 'correo') || ' ' || (CAST(cuerpo AS jsonb) -> 'cliente' ->> 'telefono') || ' ' || (CAST(cuerpo AS jsonb) -> 'cliente' -> 'direccion' ->> 'cp') FROM recorrido WHERE orden='4008' AND canal='rest' ORDER BY n LIMIT 1")
case "$D" in "T-501 2 "?"***@example.com "*"28 00028") si "Lo tapado sirve para diagnosticar: $D";;
  *) no "Lo que guarda el rastro de la 4008: «${D:-nada}» (esperaba la tienda, 2 renglones, el dominio del correo, el final del teléfono y el CP)";; esac
apagar
exit $ok
