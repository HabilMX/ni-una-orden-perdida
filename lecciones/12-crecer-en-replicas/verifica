#!/usr/bin/env bash
# Comprueba la lección 12: int-bd corre en tres copias y las 30 órdenes del lote se reparten entre ellas.
# Cada orden queda una sola vez en el ERP, y el trabajo cae en más de una copia. No se exige que TODAS reciban:
# quien elige la copia es el DNS, y con 30 órdenes una copia podría quedarse sin ninguna aunque todo esté bien.
# Uso: ./verifica [mio|solucion]   (por omisión, mio). Necesita el ambiente de la 00 arriba.
set -uo pipefail
cd "$(dirname "$0")"
RAIZ="$(cd ../.. && pwd)"
DONDE="${1:-mio}"
LOTE="$RAIZ/datos/ordenes/lote-30"
COPIAS=3
[ -d "$DONDE" ] || { echo "❌ No existe $DONDE/. Copia inicio/ a mio/ primero."; exit 1; }
[ -f "$DONDE/replicas.yaml" ] || { echo "❌ No existe $DONDE/replicas.yaml. Copia inicio/ a mio/ otra vez."; exit 1; }
ok=0; si() { echo "✅ $1"; }; no() { echo "❌ $1"; ok=1; }
INFRA() { docker compose -f "$RAIZ/infra/compose.yaml" "$@"; }
SQL() { INFRA exec -T erp mariadb -uintegracion -p"${ERP_CLAVE:-practica}" erp -N -e "$1" 2>/dev/null; }
SERV() { DONDE="$DONDE" docker compose -f compose.yaml -f "$DONDE/replicas.yaml" "$@"; }
apagar() { SERV down >/dev/null 2>&1; }
TOTAL=$(ls "$LOTE"/*.json | wc -l | tr -d ' ')

INFRA restart api-pedidos >/dev/null 2>&1
INFRA up -d --wait api-pedidos >/dev/null 2>&1 || { no "La API no levantó: ¿corriste la 00?"; exit 1; }
SQL "DELETE FROM pedido_detalle; DELETE FROM pedido_cabecera;" || { no "No pude hablar con el ERP: ¿corriste la 00?"; exit 1; }
[ "$(SQL "SELECT COUNT(*) FROM information_schema.columns WHERE table_schema='erp' AND table_name='pedido_cabecera' AND column_name='correlacion'")" = "1" ] \
  || { no "Tu ERP no tiene la columna correlacion. Recréalo: docker compose -f infra/compose.yaml up -d --wait --force-recreate -V erp"; exit 1; }
(cd "$DONDE/int-edi" && "$RAIZ/herramientas/confiar-en-socio" >/dev/null) || { no "No pude anotar la llave del socio"; exit 1; }
# La llave que anotamos es de TU ambiente: al salir se borra de solucion/ e inicio/ (en mio/ se queda: es tuya)
[ "$DONDE" = "mio" ] || trap 'rm -f "$DONDE/int-edi/known_hosts"' EXIT
API=$(INFRA ps -q api-pedidos); DESDE=$(docker inspect -f '{{.State.StartedAt}}' "$API")

apagar
if curl -s -o /dev/null --max-time 2 localhost:8080; then
  no "El puerto 8080 está ocupado: apaga lo que dejaste corriendo (Ctrl+C o «docker compose … down») y vuelve a intentar"; exit 1
fi
SERV up -d >/dev/null 2>&1 || { no "No pude levantar los servicios. Revisa que $DONDE/replicas.yaml sea YAML válido:"; SERV config 2>&1 | tail -3; apagar; exit 1; }

# ¿Cuántas copias de int-bd pidió replicas.yaml? Se cuentan los contenedores, no lo que dice el archivo
N_BD=$(SERV ps -q int-bd | wc -l | tr -d ' ')
[ "$N_BD" = "$COPIAS" ] && si "int-bd corre en $COPIAS copias" \
  || no "int-bd corre en $N_BD copia(s) y se esperaban $COPIAS: ¿pusiste las réplicas en replicas.yaml?"
ESPERA=$((3 + N_BD))
LISTOS() { SERV logs 2>/dev/null | grep -cE 'Started (orden-router|int-rest|int-bd|int-edi) '; }
for i in $(seq 1 120); do [ "$(LISTOS)" -ge "$ESPERA" ] && break; sleep 2; done
[ "$(LISTOS)" -ge "$ESPERA" ] && si "Arrancaron el router, int-rest, int-edi y las copias de int-bd" \
  || { no "No arrancaron los servicios. Esto dijeron:"; SERV logs 2>/dev/null | grep -E "ERROR|Exception" | head -10; apagar; exit 1; }

# Una orden cada segundo y medio, como llegan de una tienda: más espaciadas que la vida de una conexión
for f in "$LOTE"/*.json; do
  curl -s -o /dev/null --max-time 60 -XPOST localhost:8080/ordenes -H 'Content-Type: application/json' -d @"$f"
  sleep 1.5
done
sleep 2

ERP_N=$(SQL "SELECT COUNT(*) FROM pedido_cabecera WHERE estatus='REGISTRADO'")
[ "$ERP_N" = "$TOTAL" ] && si "ERP: tiene las $TOTAL órdenes REGISTRADO, cada una una sola vez" \
  || no "ERP: esperaba $TOTAL órdenes REGISTRADO y tiene ${ERP_N:-0}"
API_N=$(docker logs --since "$DESDE" "$API" 2>&1 | grep -cE "201 llave=30[0-9]{2} ")
[ "$API_N" = "$TOTAL" ] && si "API: tiene las $TOTAL órdenes (crecer int-bd no tocó a los demás)" \
  || no "API: esperaba $TOTAL órdenes y tiene $API_N"

# Quién registró qué: lo dice el log de cada copia, no la respuesta del router
REPARTO=""; SUMA=0; CON=0
for c in $(SERV ps -q int-bd); do
  n=$(docker logs "$c" 2>&1 | grep -c "El ERP registró el pedido 30")
  REPARTO="$REPARTO$(docker inspect -f '{{.Name}}' "$c" | sed 's|^/||')=$n "
  SUMA=$((SUMA + n)); [ "$n" -ge 1 ] && CON=$((CON + 1))
done
echo "   Reparto: $REPARTO"
[ "$SUMA" = "$TOTAL" ] && si "Entre todas las copias registraron $SUMA órdenes: ni una de más, ni una de menos" \
  || no "Entre todas las copias registraron $SUMA órdenes y se esperaban $TOTAL"
if [ "$N_BD" -ge 2 ] && [ "$CON" -ge 2 ]; then
  si "$CON de $N_BD copias de int-bd registraron órdenes: el trabajo se repartió"
elif [ "$N_BD" -ge 2 ]; then
  no "Solo $CON de $N_BD copias registró órdenes: el router sigue usando la misma conexión. ¿Le diste al router una vida de conexión y un DNS corto?"
else
  no "Con una sola copia no hay nada que repartir"
fi
apagar
exit $ok
