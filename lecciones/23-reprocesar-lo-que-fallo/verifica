#!/usr/bin/env bash
# Comprueba la lección 23: reprocesar a mano solo lo que falló, con quién y por qué, sin duplicar nada.
#   1. Con el SFTP del socio caído llegan 4001…4004: su canal edi queda pendiente (el cortacircuito de la 22).
#   2. Con la API lenta llega la 4005: su canal rest no supo (504) y la API sí la registró (como en la 20).
#   3. Vuelven el SFTP y la API. POST /rerun de cada una: intento «manual» con quién, por qué y la versión del mapeo;
#      un solo 850 por orden en el socio y un solo pedido 4005 en la API (contestó «reenvío»).
#   4. Un rerun de lo que ya salió bien se niega (409) y uno sin motivo también (400).
#   5. El ERP reconoce un pedido que ya tiene; y el 997 del socio confirma lo reprocesado.
# Uso: ./verifica [mio|solucion]   (por omisión, mio). Necesita el ambiente de la 00 arriba.
set -uo pipefail
cd "$(dirname "$0")"
RAIZ="$(cd ../.. && pwd)"
DONDE="${1:-mio}"
[ -d "$DONDE" ] || { echo "❌ No existe $DONDE/. Copia inicio/ a mio/ primero."; exit 1; }
hay() { grep "$@" >/dev/null; }   # grep sin -q: con pipefail, -q corta la tubería y da falsos rojos
ok=0; si() { echo "✅ $1"; }; no() { echo "❌ $1"; ok=1; }
INFRA() { docker compose -f "$RAIZ/infra/compose.yaml" "$@"; }
SQL() { INFRA exec -T erp mariadb -uintegracion -p"${ERP_CLAVE:-practica}" erp -N -e "$1" 2>/dev/null; }
EST() { INFRA exec -T estado psql -U router -d estado -tAF $'\t' -c "$1" 2>/dev/null; }
SOCIO() { INFRA exec -T socio-sftp sh -c "$1" 2>/dev/null; }
SERV() { DONDE="$DONDE" docker compose -f compose.yaml "$@"; }
apagar() { SERV down >/dev/null 2>&1; }
CAMPO() { curl -s "localhost:8081/pedidos/$1" | python3 -c "import sys,json; print(json.load(sys.stdin).get('$2'))" 2>/dev/null; }
DATOS="$RAIZ/datos"
# Cuántas operaciones de una orden y un momento ya tienen desenlace (ni pendientes ni estacionadas)
TERMINADAS() { EST "SELECT COUNT(*) FROM operacion WHERE orden='$1' AND momento='$2' AND estado NOT IN ('pendiente','estacionada')"; }
ESTACIONADAS() { EST "SELECT COUNT(*) FROM operacion WHERE orden='$1' AND momento='$2' AND estado = 'estacionada'"; }
esperar_est() { for i in $(seq 1 20); do [ "$(ESTACIONADAS "$1" "$2")" -ge "$3" ] && return 0; sleep 1; done; return 1; }
esperar_ops() { for i in $(seq 1 40); do [ "$(TERMINADAS "$1" "$2")" -ge "$3" ] && return 0; sleep 2; done; return 1; }

# Todo empieza limpio: los destinos y la base de estado
INFRA restart api-pedidos >/dev/null 2>&1
INFRA up -d --wait api-pedidos erp estado >/dev/null 2>&1 || { no "El ambiente no levantó: ¿corriste la 00?"; exit 1; }
SQL "DELETE FROM entrega; DELETE FROM embarque; DELETE FROM pedido_detalle; DELETE FROM pedido_cabecera;" || { no "No pude hablar con el ERP"; exit 1; }
[ "$(EST "SELECT COUNT(*) FROM information_schema.columns WHERE table_name='operacion' AND column_name='correlacion'")" = "1" ] \
  && [ "$(EST "SELECT COUNT(*) FROM pg_class WHERE relname='numero_control_seq'")" = "1" ] \
  || { no "A la base de estado le falta la secuencia numero_control_seq o la columna correlacion. Recréala: docker compose -f infra/compose.yaml up -d --wait --force-recreate -V estado"; exit 1; }
EST "TRUNCATE acuse, conflicto, intento, operacion, orden RESTART IDENTITY CASCADE" >/dev/null || { no "No pude limpiar la base de estado"; exit 1; }
SOCIO "rm -rf /home/socio/entrada/* /home/socio/salida/* /home/socio/salida/.leidos" || { no "No pude hablar con el SFTP del socio"; exit 1; }
(cd "$DONDE/int-edi" && "$RAIZ/herramientas/confiar-en-socio" >/dev/null) || { no "No pude anotar la llave del socio"; exit 1; }
# El router también entra al SFTP del socio desde la 21: a leer los acuses
(cd "$DONDE/orden-router" && "$RAIZ/herramientas/confiar-en-socio" >/dev/null) || { no "No pude anotar la llave del socio para el router"; exit 1; }
[ "$DONDE" = "mio" ] || trap 'rm -f "$DONDE/int-edi/known_hosts" "$DONDE/orden-router/known_hosts"' EXIT
[ "$(INFRA ps --format '{{.Service}} {{.State}}' | awk '$1=="socio-bot"{print $2}')" = "running" ] \
  || { no "No está arriba socio-bot, el sistema del socio que manda los 997: docker compose -f infra/compose.yaml up -d --wait"; exit 1; }
rm -rf buzon; mkdir -p buzon

apagar
if curl -s -o /dev/null --max-time 2 localhost:8080; then
  no "El puerto 8080 está ocupado: apaga lo que dejaste corriendo (Ctrl+C o «docker compose … down») y vuelve a intentar"; exit 1
fi
SERV up -d >/dev/null 2>&1 || { no "No pude levantar los servicios de la lección"; apagar; exit 1; }
RUTAS="rerun|preparar|llamar-canal|sin-respuesta|sondeo-acuses|correlacionar-acuse|intentar|reconocer|recibir-momento|contestar-reconocido|barrido-http|barrido|decidir|webhook-paqueteria|int-rest-entrega|int-bd-entrega|int-edi-entrega|orden-router|embarque-router|hilo|contestar-y-repartir|no-existe|canales|cargar-orden|guardar-orden|guardar-momento|repartir|enviar|int-rest|int-bd|int-edi|int-rest-embarque|int-bd-embarque|int-edi-embarque|sondeo-bodega"
LISTOS() { SERV logs 2>/dev/null | grep -cE "Started ($RUTAS) "; }
for i in $(seq 1 90); do [ "$(LISTOS)" -ge 35 ] && break; sleep 2; done
[ "$(LISTOS)" -ge 35 ] && si "Arrancaron el router (con su POST /rerun), los tres canales y el sondeo" \
  || { no "No arrancaron todas las rutas. Esto dijeron:"; SERV logs 2>/dev/null | grep -E "ERROR|Exception" | head -10; apagar; exit 1; }

MODO() { curl -s -o /dev/null -w "%{http_code}" --max-time 5 -XPOST localhost:8081/admin/modo -H 'Content-Type: application/json' -d "$1"; }
ORDEN() { curl -s -o /dev/null --max-time 10 -XPOST localhost:8080/ordenes -H 'Content-Type: application/json' -d @"$DATOS/ordenes/tramo-2/orden-$1.json"; }
# Un rerun: orden, momento, canal, y el resto del cuerpo (quién y por qué). Devuelve el código HTTP.
RERUN() { curl -s -o /dev/null -w "%{http_code}" --max-time 30 -XPOST localhost:8080/rerun -H 'Content-Type: application/json' \
  -d "{\"orden\":\"$1\",\"momento\":\"creada\",\"canal\":\"$2\"$3}"; }
QUIEN=',"pedido_por":"mesa-de-control","motivo":"volvió el canal; reprocesar lo que quedó sin enviar"'
ESTADO() { EST "SELECT estado FROM operacion WHERE orden='$1' AND momento='creada' AND canal='$2'"; }
esperar_estado() { for i in $(seq 1 $4); do case " $3 " in *" $(ESTADO "$1" "$2") "*) return 0;; esac; sleep 1; done; return 1; }
# Pase lo que pase, al salir vuelven el SFTP y la API en modo normal
trap 'INFRA start socio-sftp >/dev/null 2>&1; MODO "{\"modo\":\"normal\"}" >/dev/null; [ "$DONDE" = "mio" ] || rm -f "$DONDE/int-edi/known_hosts" "$DONDE/orden-router/known_hosts"' EXIT
T0=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# 1. Se cae el SFTP del socio y llegan cuatro órdenes: el canal edi queda pendiente
INFRA stop socio-sftp >/dev/null 2>&1
for o in 4001 4002 4003 4004; do ORDEN $o; done
for i in $(seq 1 25); do [ "$(EST "SELECT COUNT(*) FROM operacion WHERE momento='creada' AND canal IN ('rest','bd') AND estado='aceptada'")" = "8" ] && break; sleep 1; done
EDI=$(EST "SELECT string_agg(estado, ' ' ORDER BY orden) FROM operacion WHERE momento='creada' AND canal='edi'")
[ "$EDI" = "pendiente pendiente pendiente pendiente" ] && si "Con el SFTP caído, el canal del socio de la 4001 a la 4004 quedó pendiente (lo que se reprocesa)" \
  || { no "Con el SFTP caído esperaba el canal del socio pendiente en las 4; quedó «${EDI:-nada}»"; apagar; exit 1; }

# 2. Vuelve el SFTP (pasada la espera del cortacircuito); la API se pone lenta y llega la 4005
INFRA start socio-sftp >/dev/null 2>&1; INFRA up -d --wait socio-sftp >/dev/null 2>&1
sleep 12
[ "$(MODO '{"modo":"lento","espera_ms":10000}')" = "200" ] || { no "No pude poner la API en modo lento (¿es la 1.4.0? recréala con la 00)"; apagar; exit 1; }
ORDEN 4005; T5=$(date +%s)
# Se espera a que el router se rinda: o se agotaron los reintentos (conciliacion_pendiente), o el cortacircuito de
# rest se abrió y el último intento ya no se envió (pendiente con un intento no_enviado)
RINDIO() { EST "SELECT COUNT(*) FROM operacion p WHERE p.orden='4005' AND p.momento='creada' AND p.canal='rest' AND (p.estado='conciliacion_pendiente' OR (p.estado='pendiente' AND (SELECT i.desenlace FROM intento i WHERE i.operacion=p.id ORDER BY i.n DESC LIMIT 1)='no_enviado'))"; }
for i in $(seq 1 60); do [ "$(RINDIO)" = "1" ] && break; sleep 1; done
R5=$(ESTADO 4005 rest)
case "$R5" in pendiente|conciliacion_pendiente) si "Con la API lenta, el canal rest de la 4005 no supo cómo le fue y quedó $R5";;
  *) no "Con la API lenta esperaba el canal rest de la 4005 pendiente o en conciliación; quedó «${R5:-nada}»";; esac
# La API lenta registra a los 10 s; el cortacircuito de rest espera 10 s: se le da tiempo a los dos
while [ $(( $(date +%s) - T5 )) -lt 24 ]; do sleep 1; done
MODO '{"modo":"normal"}' >/dev/null
[ "$(CAMPO 4005 estatus)" = "CREADO" ] || no "La API debía tener ya la 4005 (la registró la llamada lenta); tiene «$(CAMPO 4005 estatus)»"

# 3. Los reruns: el canal del socio de las cuatro y el rest de la 4005
ANTES_BD=$(EST "SELECT COUNT(*) FROM intento i JOIN operacion p ON p.id=i.operacion WHERE p.canal IN ('rest','bd') AND p.orden <> '4005'")
for o in 4001 4002 4003 4004; do RERUN $o edi "$QUIEN" >/dev/null; done
RERUN 4005 rest "$QUIEN" >/dev/null
for o in 4001 4002 4003 4004; do esperar_estado $o edi "aceptada confirmada" 20 >/dev/null; done
esperar_estado 4005 rest "aceptada" 20 >/dev/null
LISTOS5=$(EST "SELECT COUNT(*) FROM operacion WHERE momento='creada' AND ((canal='edi' AND orden IN ('4001','4002','4003','4004') AND estado IN ('aceptada','confirmada')) OR (canal='rest' AND orden='4005' AND estado='aceptada'))")
[ "$LISTOS5" = "5" ] && si "Rerun: el canal del socio de la 4001 a la 4004 y el rest de la 4005 quedaron aceptados" \
  || no "Rerun: de las 5 operaciones reprocesadas, $LISTOS5 quedaron aceptadas"
MAN=$(EST "SELECT COUNT(*) FROM intento i JOIN operacion p ON p.id=i.operacion WHERE i.tipo='manual' AND i.pedido_por='mesa-de-control' AND i.motivo LIKE 'volvió el canal%' AND i.desenlace='aceptada' AND ((p.canal='edi' AND i.version_mapeo='edi/850/v2') OR (p.canal='rest' AND i.version_mapeo='api/pedido/v2'))")
[ "$MAN" = "5" ] && si "Cada rerun quedó como intento «manual», con quién lo pidió, por qué y la versión del mapeo con que salió" \
  || no "Esperaba 5 intentos manuales con pedido_por, motivo y version_mapeo; hay $MAN"
N850=$(SOCIO 'ls /home/socio/entrada/' | grep -c '^850-400[1-5]\.edi$')
D201=$(INFRA logs --since "$T0" api-pedidos 2>/dev/null | grep -c '201 llave=[^ ]* pedido=4005 ')
C5=$(EST "SELECT i.respuesta->>'codigo' FROM intento i JOIN operacion p ON p.id=i.operacion WHERE p.orden='4005' AND p.momento='creada' AND p.canal='rest' ORDER BY i.n DESC LIMIT 1")
[ "$N850" = "5" ] && [ "$D201" = "1" ] && [ "$C5" = "200" ] \
  && si "Sin duplicados: un 850 por orden en el socio, y la API creó la 4005 una vez y al rerun contestó 200 «reenvío»" \
  || no "Duplicados: hay $N850 de 5 archivos 850 en el socio, la API creó la 4005 $D201 veces y al rerun contestó «${C5:-nada}»"
DESPUES_BD=$(EST "SELECT COUNT(*) FROM intento i JOIN operacion p ON p.id=i.operacion WHERE p.canal IN ('rest','bd') AND p.orden <> '4005'")
[ "$ANTES_BD" = "$DESPUES_BD" ] && si "Solo el paso que falló: la API y el ERP de la 4001 a la 4004 no recibieron intentos nuevos" \
  || no "Se reprocesó de más: la API y el ERP de la 4001 a la 4004 pasaron de $ANTES_BD a $DESPUES_BD intentos"

# 4. Lo que ya salió bien no se reprocesa; sin quién o sin motivo, tampoco
N1=$(EST "SELECT COUNT(*) FROM intento i JOIN operacion p ON p.id=i.operacion WHERE p.orden='4001' AND p.canal='edi'")
C409=$(RERUN 4001 edi "$QUIEN"); sleep 3
E1=$(ESTADO 4001 edi); N1B=$(EST "SELECT COUNT(*) FROM intento i JOIN operacion p ON p.id=i.operacion WHERE p.orden='4001' AND p.canal='edi'")
[ "$C409" = "409" ] && [ "$N1" = "$N1B" ] && { [ "$E1" = "aceptada" ] || [ "$E1" = "confirmada" ]; } \
  && si "Rerun de lo que ya está aceptado: 409, sin intento nuevo y la operación sigue $E1" \
  || no "Rerun de la 4001 ya aceptada: contestó $C409, pasó de $N1 a $N1B intentos y quedó «${E1:-nada}»"
C400=$(RERUN 4002 edi ',"pedido_por":"mesa-de-control"')
[ "$C400" = "400" ] && si "Rerun sin motivo: 400 (sin quién y por qué, el rastro quedaría mudo)" || no "Rerun sin motivo: esperaba 400, contestó $C400"

# 5. El ERP reconoce un pedido que ya tiene: el mismo cuerpo otra vez a int-bd
DET=$(SQL "SELECT COUNT(*) FROM pedido_detalle WHERE pedido='4001'")
RESP=$(SERV exec -T int-bd curl -s -w ' %{http_code}' -XPOST localhost:8080/integrar -H 'Content-Type: application/json' -H 'ce-correlationid: verifica-23' --data-binary @- < "$DATOS/ordenes/tramo-2/orden-4001.json" 2>/dev/null)
DETB=$(SQL "SELECT COUNT(*) FROM pedido_detalle WHERE pedido='4001'")
printf '%s' "$RESP" | hay 'YA_REGISTRADO.* 200$' && [ "$DET" = "$DETB" ] \
  && si "El ERP reconoce un pedido que ya tiene: 200 «ya registrado», sin renglones nuevos" \
  || no "El ERP con la 4001 otra vez contestó «${RESP:-nada}» y tiene $DETB renglones (antes $DET)"
# El socio acusa lo reprocesado con su 997: el número de control es el de la operación
for i in $(seq 1 25); do [ "$(EST "SELECT COUNT(*) FROM operacion WHERE momento='creada' AND canal='edi' AND orden IN ('4001','4002','4003','4004') AND estado='confirmada'")" = "4" ] && break; sleep 1; done
CONF=$(EST "SELECT COUNT(*) FROM operacion WHERE momento='creada' AND canal='edi' AND orden IN ('4001','4002','4003','4004') AND estado='confirmada'")
[ "$CONF" = "4" ] && si "El 997 del socio confirmó los cuatro 850 reprocesados" || no "Del 997 del socio: $CONF de 4 reprocesados confirmados"
apagar
exit $ok
