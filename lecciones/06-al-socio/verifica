#!/usr/bin/env bash
# Comprueba la lección 06: el 850 llega al SFTP del socio con nombre final, sin restos .tmp,
# sin pisar uno que ya estaba, y solo si el servidor presenta la llave anotada en known_hosts.
# Uso: ./verifica [mio|solucion]   (por omisión, mio). Necesita el ambiente de la 00 arriba.
set -uo pipefail
cd "$(dirname "$0")"
RAIZ="$(cd ../.. && pwd)"
DONDE="${1:-mio}"
[ -d "$DONDE" ] || { echo "❌ No existe $DONDE/. Copia inicio/ a mio/ primero."; exit 1; }
ok=0; si() { echo "✅ $1"; }; no() { echo "❌ $1"; ok=1; }
SOCIO() { docker compose -f "$RAIZ/infra/compose.yaml" exec -T socio-sftp sh -c "$1" 2>/dev/null; }
# Cada corrida tiene que DEMOSTRAR que arrancó: si no, un «no depositó» se vería verde sin haber intentado nada.
correr() { rm -rf entrada; mkdir -p entrada; cp "$1" entrada/orden.json
  LOG=$(mktemp)
  "$RAIZ/herramientas/camel" run orden-al-socio.camel.yaml --max-messages=1 --max-seconds=60 >"$LOG" 2>&1
  grep -q "Started orden-al-socio" "$LOG" || { no "La ruta no arrancó. Esto dijo Camel:"; tail -15 "$LOG"; mv known_hosts.bueno known_hosts 2>/dev/null; exit 1; }; }

SOCIO "rm -f /home/socio/entrada/*" || { no "No pude hablar con el SFTP del socio: ¿corriste la 00?"; exit 1; }
cd "$DONDE"
"$RAIZ/herramientas/confiar-en-socio" >/dev/null || { no "No pude anotar la llave del socio"; exit 1; }
# La llave que anotamos es de TU ambiente: al salir se borra de solucion/ e inicio/ (en mio/ se queda: es tuya)
[ "$DONDE" = "mio" ] || trap 'rm -f known_hosts known_hosts.bueno' EXIT

# 1) Llega con su nombre final y sin restos
correr "$RAIZ/datos/ordenes/orden-1001.json"
[ "$(SOCIO 'ls /home/socio/entrada')" = "850-1001.edi" ] && si "Llegó 850-1001.edi al SFTP del socio" || no "En el SFTP del socio no está (solo) 850-1001.edi: $(SOCIO 'ls /home/socio/entrada' | tr '\n' ' ')"
SOCIO "ls /home/socio/entrada" | grep -q "\.tmp$" && no "Quedó un .tmp en el SFTP del socio" || si "No quedó ningún archivo .tmp"
ORIGINAL=$(SOCIO "cat /home/socio/entrada/850-1001.edi")
cmp -s <(echo "$ORIGINAL") <(cat "$RAIZ/datos/edi/850-ejemplo.edi") && si "Lo que recibió el socio es el 850 correcto" || no "Lo que recibió el socio no es el 850 esperado"

# 2) La misma orden, con otro contenido: NO debe pisar lo que ya estaba
correr "$RAIZ/datos/ordenes/orden-1001-cambiada.json"
[ "$(SOCIO "cat /home/socio/entrada/850-1001.edi")" = "$ORIGINAL" ] && si "Un segundo envío de la 1001 no pisó el archivo que ya estaba" || no "Un segundo envío de la 1001 PISÓ el archivo del socio (falta que no sobrescriba)"
grep -q "tempFileName\|tempPrefix" orden-al-socio.camel.yaml && si "La ruta escribe con nombre temporal" || no "La ruta no usa nombre temporal: el socio podría leer un archivo a medias"

# 3) Si el servidor presenta otra llave, no se conecta
SOCIO "rm -f /home/socio/entrada/*"
cp known_hosts known_hosts.bueno
echo "socio-sftp ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHVuYWxsYXZlZGVvdHJvc2Vydmlkb3JxdWVub2Vz" > known_hosts
correr "$RAIZ/datos/ordenes/orden-1001.json"
mv known_hosts.bueno known_hosts
grep -q "HostKey has been changed" "$LOG" && si "La ruta intentó conectar y el servidor no presentó la llave anotada" || no "No vi el rechazo por llave («HostKey has been changed») en el log"
[ -z "$(SOCIO 'ls /home/socio/entrada')" ] && si "Con otra llave en known_hosts, la ruta se negó a conectar" || no "Con otra llave en known_hosts la ruta SÍ depositó: no está revisando la llave del servidor"
rm -rf entrada
exit $ok
