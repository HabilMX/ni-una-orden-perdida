#!/usr/bin/env bash
# Comprueba la lección 07: la orden entra al router, el router se la pasa a int-rest por su NOMBRE,
# y la API la registra. El sobre CloudEvents viaja con ella. Solo el router se ve desde tu máquina.
# Uso: ./verifica [mio|solucion]   (por omisión, mio). Necesita el ambiente de la 00 arriba.
set -uo pipefail
cd "$(dirname "$0")"
RAIZ="$(cd ../.. && pwd)"
DONDE="${1:-mio}"
[ -d "$DONDE" ] || { echo "❌ No existe $DONDE/. Copia inicio/ a mio/ primero."; exit 1; }
ok=0; si() { echo "✅ $1"; }; no() { echo "❌ $1"; ok=1; }
SERV() { DONDE="$DONDE" docker compose -f compose.yaml "$@"; }
apagar() { SERV down >/dev/null 2>&1; }

# La API demo empieza limpia (guarda en memoria): así el primer envío debe dar 201.
docker compose -f "$RAIZ/infra/compose.yaml" restart api-pedidos >/dev/null 2>&1
docker compose -f "$RAIZ/infra/compose.yaml" up -d --wait api-pedidos >/dev/null 2>&1 || { no "La API no levantó: ¿corriste la 00?"; exit 1; }

apagar   # si quedó una corrida anterior de esta lección, se apaga
if curl -s -o /dev/null --max-time 2 localhost:8080; then
  no "El puerto 8080 está ocupado: detén la ruta que dejaste corriendo (Ctrl+C) y vuelve a intentar"; exit 1
fi

SERV up -d >/dev/null 2>&1 || { no "No pude levantar los servicios de la lección"; apagar; exit 1; }
for i in $(seq 1 60); do
  [ "$(SERV logs 2>/dev/null | grep -cE 'Started (orden-router|int-rest) ')" -ge 2 ] && break; sleep 2
done
SERV logs orden-router 2>/dev/null | grep -q "Started orden-router " && si "El router arrancó" || no "El router no arrancó"
SERV logs int-rest 2>/dev/null | grep -q "Started int-rest " && si "int-rest arrancó (la misma imagen, otra carpeta)" || no "int-rest no arrancó"
[ $ok -eq 0 ] || { SERV logs 2>/dev/null | tail -20; apagar; exit 1; }

c=$(curl -s -o /dev/null -w "%{http_code}" -XPOST localhost:8080/ordenes -H 'Content-Type: application/json' \
      -d @"$RAIZ/datos/ordenes/orden-1003.json")
[ "$c" = "201" ] && si "La tienda mandó la 1003 al router y la respuesta final fue 201" || no "La tienda esperaba 201 y le llegó $c"

# Lo mira el destino: la API anota con qué llave le llegó el pedido, desde que se reinició arriba.
API=$(docker compose -f "$RAIZ/infra/compose.yaml" ps -q api-pedidos)
docker logs --since "$(docker inspect -f '{{.State.StartedAt}}' "$API")" "$API" 2>&1 | grep -q "201 llave=1003 " \
  && si "La API registró la orden 1003: el recorrido tienda → router → int-rest → API se completó" \
  || no "La API no registró la orden 1003"

SERV logs int-rest 2>/dev/null | grep -q "sobre orden-1003-creada, tipo mx.tienda.orden.creada" \
  && si "int-rest recibió el sobre CloudEvents de la orden (id orden-1003-creada)" \
  || no "int-rest no recibió el sobre CloudEvents de la orden 1003"

[ -z "$(SERV port int-rest 8080 2>/dev/null)" ] && si "int-rest no se ve desde tu máquina: solo el router lo alcanza" \
  || no "int-rest publica su puerto hacia tu máquina: solo el router debería verse"
apagar
exit $ok
