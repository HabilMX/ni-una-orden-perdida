#!/usr/bin/env bash
# Mide el MISMO int-rest en la JVM y en nativo, en TU máquina, y escribe las cifras en cifras.md (junto a este
# archivo). Para cada modo mide cuatro cosas:
#   1. construir         cuánto tarda en construirse la imagen desde cero (sin reusar lo de la vez anterior)
#   2. arranque          cuánto tarda desde que se pide el contenedor hasta que dice que está sano
#                        (/q/health/ready), y lo que el propio Quarkus dice en su bitácora («started in …»)
#   3. memoria en reposo cuánta memoria ocupa ya arrancado, sin trabajo
#   4. memoria con carga la más alta que se vio durante una carga corta de órdenes
# No compara contra ninguna cifra «buena»: las cifras son de tu máquina, tu Docker y lo que tenías corriendo.
# Uso (desde la carpeta de la lección):  ./mio/medir      Tarda unos 6 minutos: el nativo es la parte cara.
set -uo pipefail
AQUI="$(cd "$(dirname "$0")" && pwd)"
cd "$AQUI/.."
CIFRAS="$AQUI/cifras.md"
C() { docker compose "$@"; }
# Construir. El Dockerfile de int-rest vive en la carpeta de la 31 y la API en infra/: las dos quedan fuera de esta
# carpeta. Un buildx reciente no lee fuera de donde estás sin permiso explícito («additional privileges requested»),
# así que se construye con «docker buildx bake» (lee este mismo compose.yaml) dándole permiso SOLO para esas dos
# carpetas. Un buildx viejo, que no conoce --allow, tampoco pide ese permiso: ahí basta con «docker compose build».
construir() {
  if docker buildx bake --help 2>/dev/null | grep -q -- '--allow'; then
    docker buildx bake -f compose.yaml --load \
      --allow fs.read=../31-de-laboratorio-a-kubernetes --allow fs.read=../../infra/api-demo "$@"
  else
    C build "$@"
  fi
}
# La hora en milisegundos. perl viene en macOS, en Linux y en Git Bash; «date +%N» no existe en macOS.
ms() { perl -MTime::HiRes=time -e 'printf "%.0f\n", time*1000'; }
puerto() { [ "$1" = "jvm" ] && echo 8091 || echo 8092; }

# Cuánta memoria usa un contenedor, en MiB. docker stats la da como «145.8MiB / 512MiB» (o KiB, o GiB).
# TODO 1: pídele a docker stats UNA lectura (--no-stream) del contenedor "$1", solo la columna de memoria
#         (--format '{{.MemUsage}}'), y conviértela a MiB con awk: el primer número; si dice GiB, por 1024; si
#         dice KiB, entre 1024. Mientras no lo hagas, contesta «—» (sin medir).
memoria() {
  echo "—"
}

# Pide el contenedor y cuenta los milisegundos hasta que /q/health/ready contesta 200 (UP).
# TODO 2: toma la hora con «ms» ANTES de levantar el contenedor (C up -d --force-recreate "int-rest-$modo"), y
#         después pregunta cada 50 ms (sleep 0.05) con curl -sf a localhost:<puerto>/q/health/ready (el puerto
#         te lo da puerto "$modo"), a lo más 60 s.
#         En cuanto conteste, imprime la diferencia: $(( $(ms) - t0 )). Si nunca contesta, imprime «—».
#         Ojo: no basta con leer «started in» de la bitácora; eso lo dice Quarkus de sí mismo, sin contar lo que
#         tarda el contenedor en nacer. Aquí se mide lo que vería quien espera que la copia ya atienda.
hasta_sano() {
  local modo=$1
  C up -d --force-recreate "int-rest-$modo" >/dev/null 2>&1
  sleep 5
  echo "—"
}

# La carga corta: 100 órdenes por segundo durante 20 s, y mientras tanto se toma la memoria cada segundo.
# Se queda la más alta.
memoria_con_carga() {
  local modo=$1 cont tope=0 m
  cont=$(C ps -q "int-rest-$modo")
  C --profile carga run --rm carga load -qps 100 -c 4 -t 20s -keepalive=false \
    -H "ce-subject: carga-$modo" -H "Content-Type: application/json" -payload-file /ordenes/orden-1001.json \
    "http://int-rest-$modo:8080/integrar" >"$AQUI/carga-$modo.log" 2>&1 &
  local carga=$!
  # TODO 3: MIENTRAS la carga corre (kill -0 "$carga" dice si sigue viva), toma la memoria de "$cont" cada
  #         segundo con tu función memoria, y quédate con la más alta en «tope». Una sola lectura al final no
  #         sirve: la carga ya terminó y la memoria pudo haber bajado.
  wait "$carga"
  echo "$tope"
}

echo "1. Construyendo las dos imágenes desde cero (la nativa tarda varios minutos)…"
construir api-pedidos >/dev/null 2>&1 || { echo "No pude construir la API"; exit 1; }
declare -a FILAS
for modo in jvm nativo; do
  t0=$(ms)
  if construir --no-cache "int-rest-$modo" >"$AQUI/build-$modo.log" 2>&1; then
    construir=$(awk -v d=$(( $(ms) - t0 )) 'BEGIN{printf "%.1f", d/1000}')
  else
    echo "   No se pudo construir int-rest-$modo. Lo último que dijo:"; tail -10 "$AQUI/build-$modo.log"; construir="—"
  fi
  echo "   $modo: $construir s"
  FILAS+=("$modo|$construir")
done

C up -d --wait api-pedidos >/dev/null 2>&1 || C up -d api-pedidos >/dev/null 2>&1
sleep 3
echo "2. Arranque, memoria en reposo y memoria con carga, un modo a la vez…"
SALIDA=()
for fila in "${FILAS[@]}"; do
  modo=${fila%%|*}; construir=${fila#*|}
  C stop int-rest-jvm int-rest-nativo >/dev/null 2>&1    # uno a la vez: que el otro no le quite CPU
  sano=$(hasta_sano "$modo")
  quarkus=$(C logs "int-rest-$modo" 2>/dev/null | sed -n 's/.*started in \([0-9.]*\)s.*/\1/p' | tail -1)
  sleep 10                                               # que se asiente antes de medir en reposo
  reposo=$(memoria "$(C ps -q "int-rest-$modo")")
  carga=$(memoria_con_carga "$modo")
  imagen=$(docker image inspect -f '{{.Size}}' "ni-una-orden-perdida/int-rest:$modo" 2>/dev/null | awk '{printf "%.0f", $1/1000000}')
  echo "   $modo: sano en ${sano} ms (Quarkus: ${quarkus:-—} s), reposo ${reposo:-—} MiB, con carga ${carga:-—} MiB"
  SALIDA+=("| $modo | $construir | ${quarkus:-—} | ${sano:-—} | ${reposo:-—} | ${carga:-—} | ${imagen:-—} |")
done
C stop int-rest-jvm int-rest-nativo >/dev/null 2>&1

{
  echo "# Cifras de la lección 32"
  echo
  echo "Medido el $(date '+%Y-%m-%d %H:%M') en $(uname -s) $(uname -m), con Docker $(docker version -f '{{.Server.Version}}' 2>/dev/null)," \
       "$(docker info -f '{{.NCPU}}' 2>/dev/null) CPU y $(docker info -f '{{.MemTotal}}' 2>/dev/null | awk '{printf "%.1f", $1/1073741824}') GiB para Docker."
  echo "Cada contenedor con el mismo techo: 1 CPU y 512 MiB. Carga: 100 órdenes por segundo durante 20 s."
  echo
  echo "| Modo | Construir (s) | Quarkus dice «started in» (s) | Hasta sano (ms) | Memoria en reposo (MiB) | Memoria con carga (MiB) | Imagen (MB) |"
  echo "|---|---|---|---|---|---|---|"
  printf '%s\n' "${SALIDA[@]}"
} >"$CIFRAS"
echo "Listo: las cifras quedaron en ${CIFRAS#"$PWD"/}"
