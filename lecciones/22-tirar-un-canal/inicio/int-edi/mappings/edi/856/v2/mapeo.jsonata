/* Versión 2 del 856: lo mismo que la v1, pero el NÚMERO DE CONTROL ya no sale de la orden. Lo asigna el router
   (secuencia numero_control_seq de la base de estado), uno nuevo por documento, y llega junto con los datos:
     {"control": "100000007", "datos": <lo que llegó del router>}
   El ISA13 y el GS06 llevan ese número. Sin él, el mapeo se niega: un X12 sin número de control no se manda.
   Lo demás se explica en la v1 (mappings/edi/856/v1/mapeo.jsonata). */
(
  $control := $exists(control) and $length(control) = 9 ? control
    : $error("Falta el número de control del router (9 dígitos), o no mide 9");
  datos.(
    $limpiar := function($t) { $replace($t, /[*~>]/, " ") };
    $emisor := "TIENDANORTE";
    $receptor := "SOCIO01";
    $aaaammdd := $replace($substring(embarcada, 0, 10), "-", "");
    $hhmm := $replace($substring(embarcada, 11, 5), ":", "");
    {
      "isa": {
        "emisor": $pad($emisor, 15),
        "receptor": $pad($receptor, 15),
        "fecha": $substring($aaaammdd, 2),
        "hora": $hhmm,
        "control": $control
      },
      "gs": { "emisor": $emisor, "receptor": $receptor, "fecha": $aaaammdd, "hora": $hhmm, "control": $control },
      "st": { "control": "0001" },
      "bsn": { "embarque": $limpiar(embarque), "fecha": $aaaammdd, "hora": $hhmm },
      "envio": { "paqueteria": $limpiar(paqueteria), "guia": $limpiar(guia), "fecha": $aaaammdd, "hora": $hhmm },
      "orden": orden,
      "lineas": [renglones.{
        "hl": 2 + renglon,                       /* el 1 es el embarque y el 2 la orden */
        "n": renglon,
        "sku": $limpiar(sku),
        "cantidad": cantidad
      }],
      "ctt": $count(renglones),
      /* ST, BSN, HL(S), TD5, REF, DTM, HL(O), PRF + (HL, LIN, SN1) por renglón + CTT, SE */
      "se": { "segmentos": 8 + 3 * $count(renglones) + 2 }
    }
  )
)
