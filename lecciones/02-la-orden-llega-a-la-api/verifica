#!/usr/bin/env bash
# Comprueba la lección 02: la orden entra por HTTP, se traduce y la API la registra una sola vez.
# Uso: ./verifica [mio|solucion]   (por omisión, mio). Necesita el ambiente de la 00 arriba.
set -uo pipefail
# hay: como «grep -q», pero lee la entrada completa. Con pipefail, «grep -q» corta la tubería al primer acierto,
# el comando de antes muere por SIGPIPE y la búsqueda que sí encontró se cuenta como falla.
hay() { grep "$@" >/dev/null; }
cd "$(dirname "$0")"
RAIZ="$(cd ../.. && pwd)"
DONDE="${1:-mio}"
[ -d "$DONDE" ] || { echo "❌ No existe $DONDE/. Copia inicio/ a mio/ primero."; exit 1; }
ok=0; si() { echo "✅ $1"; }; no() { echo "❌ $1"; ok=1; }

# La API demo empieza limpia (guarda en memoria): así el primer envío debe dar 201.
docker compose -f "$RAIZ/infra/compose.yaml" restart api-pedidos >/dev/null 2>&1
docker compose -f "$RAIZ/infra/compose.yaml" up -d --wait api-pedidos >/dev/null 2>&1 || { no "La API no levantó: ¿corriste la 00?"; exit 1; }

# Si otra ruta sigue corriendo, el puerto 8080 está ocupado y esta no podría arrancar.
if curl -s -o /dev/null --max-time 2 localhost:8080; then
  no "El puerto 8080 está ocupado: detén la ruta que dejaste corriendo (Ctrl+C) y vuelve a intentar"; exit 1
fi

LOG=$(mktemp); cd "$DONDE"
"$RAIZ/herramientas/camel" run orden-a-api.camel.yaml --max-seconds=90 >"$LOG" 2>&1 &
PID=$!
for i in $(seq 1 60); do hay "Started orden-a-api" "$LOG" && break; sleep 2; done
hay "Started orden-a-api" "$LOG" && si "La ruta arrancó" || { no "La ruta no arrancó (revisa $LOG)"; kill $PID 2>/dev/null; exit 1; }

ORDEN="$RAIZ/datos/ordenes/orden-1001.json"
c1=$(curl -s -o /dev/null -w "%{http_code}" -XPOST localhost:8080/ordenes -H 'Content-Type: application/json' -d @"$ORDEN")
c2=$(curl -s -o /dev/null -w "%{http_code}" -XPOST localhost:8080/ordenes -H 'Content-Type: application/json' -d @"$ORDEN")
[ "$c1" = "201" ] && si "Primer envío: la API creó el pedido (201)" || no "Primer envío: esperaba 201 y llegó $c1"
[ "$c2" = "200" ] && si "Reenvío: la API lo reconoció y no lo duplicó (200)" || no "Reenvío: esperaba 200 y llegó $c2"

p=$(curl -s localhost:8081/pedidos/1001)
echo "$p" | python3 -c "import sys,json; d=json.load(sys.stdin); assert d['pedido']=='1001' and len(d['partidas'])==2" 2>/dev/null \
  && si "La API tiene el pedido 1001 con sus 2 partidas" || no "La API no tiene el pedido 1001 completo: $p"

# Lo mira el destino, no nuestra ruta: la API anota con qué llave le llegó el pedido.
# Solo lo que anotó desde que se reinició al inicio de esta comprobación.
API=$(docker compose -f "$RAIZ/infra/compose.yaml" ps -q api-pedidos)
DESDE=$(docker inspect -f '{{.State.StartedAt}}' "$API")
docker logs --since "$DESDE" "$API" 2>&1 | hay "201 llave=1001 " \
  && si "La API recibió la llave 1001: el id de la orden viajó hasta el destino" || no "La API no recibió la llave 1001"
docker stop $(docker ps -q --filter ancestor=apache/camel-jbang:4.22.1) >/dev/null 2>&1; wait $PID 2>/dev/null
exit $ok
