/* Versión 1 (lección 27): lo que sale a un canal, con los datos personales tapados, para guardarlo en el rastro.
   El rastro (payload, y lo que muestra el recorrido) es para diagnosticar: ahí hacen falta la orden, la tienda, los
   renglones y los totales, no quién es la clienta. Lo que se manda al destino NO pasa por aquí: sale completo.

   $mascara tapa un valor y deja ver solo lo que ayuda a diagnosticar:
     iniciales   «Ana Ejemplo Prueba»      → «A. E. P.»
     correo      «ana.prueba@example.com»  → «a***@example.com»   (el dominio dice si el correo era válido)
     telefono    «+52 55 0000 0428»        → «*** **** **28»      (los dos últimos, para reconocer el número)
     todo        «Calle de Ejemplo 28»     → «***»
   Lo que no es personal queda igual. Un campo que no viene sigue sin venir. */
(
  $mascara := function($v, $modo) {
    $not($exists($v)) ? $v
    : $modo = 'iniciales' ? $join($map($split($trim($v), ' '), function($p) { $substring($p, 0, 1) & '.' }), ' ')
    : $modo = 'correo' ? $substring($v, 0, 1) & '***@' & $substringAfter($v, '@')
    : $modo = 'telefono' ? '*** **** **' & $substring($replace($v, /[^0-9]/, ''), -2)
    : '***'
  };
  $
    ~> | cliente | {
         "nombre": $mascara(nombre, 'iniciales'),
         "correo": $mascara(correo, 'correo'),
         "telefono": $mascara(telefono, 'telefono')
       } |
    ~> | cliente.direccion | { "calle": $mascara(calle, 'todo') } |
    ~> | $ | { "recibio": $mascara(recibio, 'iniciales') } |
)
