#!/usr/bin/env bash
# Comprueba la lección 18: la paquetería avisa DOS veces la entrega de la 4001 (la segunda, con el mismo
# contenido escrito de otra forma). El router reconoce el repetido: contesta 202 y no reparte nada, así que el socio
# tiene un solo 214 y la API un solo 201. Luego llega un aviso con la misma llave y OTRA guía: es un conflicto, no
# un repetido. Se contesta 409, queda en la tabla conflicto con las dos huellas, se avisa en el log y no se pisa nada.
# Uso: ./verifica [mio|solucion]   (por omisión, mio). Necesita el ambiente de la 00 arriba.
set -uo pipefail
cd "$(dirname "$0")"
RAIZ="$(cd ../.. && pwd)"
DONDE="${1:-mio}"
[ -d "$DONDE" ] || { echo "❌ No existe $DONDE/. Copia inicio/ a mio/ primero."; exit 1; }
hay() { grep "$@" >/dev/null; }   # grep sin -q: con pipefail, -q corta la tubería y da falsos rojos
ok=0; si() { echo "✅ $1"; }; no() { echo "❌ $1"; ok=1; }
INFRA() { docker compose -f "$RAIZ/infra/compose.yaml" "$@"; }
SQL() { INFRA exec -T erp mariadb -uintegracion -p"${ERP_CLAVE:-practica}" erp -N -e "$1" 2>/dev/null; }
EST() { INFRA exec -T estado psql -U router -d estado -tAF $'\t' -c "$1" 2>/dev/null; }
SOCIO() { INFRA exec -T socio-sftp sh -c "$1" 2>/dev/null; }
SERV() { DONDE="$DONDE" docker compose -f compose.yaml "$@"; }
apagar() { SERV down >/dev/null 2>&1; }
CAMPO() { curl -s "localhost:8081/pedidos/$1" | python3 -c "import sys,json; print(json.load(sys.stdin).get('$2'))" 2>/dev/null; }
DATOS="$RAIZ/datos"
# Cuántas operaciones de una orden y un momento ya tienen desenlace (ni pendientes ni estacionadas)
TERMINADAS() { EST "SELECT COUNT(*) FROM operacion WHERE orden='$1' AND momento='$2' AND estado NOT IN ('pendiente','estacionada')"; }
ESTACIONADAS() { EST "SELECT COUNT(*) FROM operacion WHERE orden='$1' AND momento='$2' AND estado = 'estacionada'"; }
esperar_est() { for i in $(seq 1 20); do [ "$(ESTACIONADAS "$1" "$2")" -ge "$3" ] && return 0; sleep 1; done; return 1; }
esperar_ops() { for i in $(seq 1 40); do [ "$(TERMINADAS "$1" "$2")" -ge "$3" ] && return 0; sleep 2; done; return 1; }

# Todo empieza limpio: los destinos y la base de estado
INFRA restart api-pedidos >/dev/null 2>&1
INFRA up -d --wait api-pedidos erp estado >/dev/null 2>&1 || { no "El ambiente no levantó: ¿corriste la 00?"; exit 1; }
SQL "DELETE FROM entrega; DELETE FROM embarque; DELETE FROM pedido_detalle; DELETE FROM pedido_cabecera;" || { no "No pude hablar con el ERP"; exit 1; }
[ "$(EST "SELECT COUNT(*) FROM information_schema.columns WHERE table_name='operacion' AND column_name='correlacion'")" = "1" ] \
  && [ "$(EST "SELECT COUNT(*) FROM pg_class WHERE relname='numero_control_seq'")" = "1" ] \
  || { no "A la base de estado le falta la secuencia numero_control_seq o la columna correlacion. Recréala: docker compose -f infra/compose.yaml up -d --wait --force-recreate -V estado"; exit 1; }
EST "TRUNCATE conflicto, intento, operacion, orden RESTART IDENTITY CASCADE" >/dev/null || { no "No pude limpiar la base de estado"; exit 1; }
SOCIO "rm -f /home/socio/entrada/*" || { no "No pude hablar con el SFTP del socio"; exit 1; }
(cd "$DONDE/int-edi" && "$RAIZ/herramientas/confiar-en-socio" >/dev/null) || { no "No pude anotar la llave del socio"; exit 1; }
[ "$DONDE" = "mio" ] || trap 'rm -f "$DONDE/int-edi/known_hosts"' EXIT
rm -rf buzon; mkdir -p buzon

apagar
if curl -s -o /dev/null --max-time 2 localhost:8080; then
  no "El puerto 8080 está ocupado: apaga lo que dejaste corriendo (Ctrl+C o «docker compose … down») y vuelve a intentar"; exit 1
fi
SERV up -d >/dev/null 2>&1 || { no "No pude levantar los servicios de la lección"; apagar; exit 1; }
RUTAS="reconocer|recibir-momento|contestar-reconocido|barrido-http|barrido|decidir|webhook-paqueteria|int-rest-entrega|int-bd-entrega|int-edi-entrega|orden-router|embarque-router|hilo|contestar-y-repartir|no-existe|canales|cargar-orden|guardar-orden|guardar-momento|repartir|enviar|int-rest|int-bd|int-edi|int-rest-embarque|int-bd-embarque|int-edi-embarque|sondeo-bodega"
LISTOS() { SERV logs 2>/dev/null | grep -cE "Started ($RUTAS) "; }
for i in $(seq 1 90); do [ "$(LISTOS)" -ge 28 ] && break; sleep 2; done
[ "$(LISTOS)" -ge 28 ] && si "Arrancaron el router (con su reconocedor de repetidos), los tres canales y el sondeo" \
  || { no "No arrancaron todas las rutas. Esto dijeron:"; SERV logs 2>/dev/null | grep -E "ERROR|Exception" | head -10; apagar; exit 1; }
T0=$(date -u +%Y-%m-%dT%H:%M:%SZ)   # desde aquí se cuentan los 201 de la API (sus registros guardan corridas anteriores)

# La 4001 se crea y se embarca, como en la 16
curl -s -o /dev/null --max-time 10 -XPOST localhost:8080/ordenes -H 'Content-Type: application/json' -d @"$DATOS/ordenes/tramo-2/orden-4001.json"
esperar_ops 4001 creada 3
python3 -c "import json,sys; e=json.load(open(sys.argv[1])); json.dump({'lote':'9001','bodega':'B-NORTE','embarques':[e]}, open('buzon/lote-bodega-9001.json','w'))" "$DATOS/embarques/embarque-4001.json"
esperar_ops 4001 embarcada 3
[ "$(CAMPO 4001 estatus)" = "EMBARCADO" ] && si "Antes de los avisos: la 4001 está EMBARCADO" \
  || { no "La 4001 no llegó a EMBARCADO; sin eso no hay entrega que probar"; apagar; exit 1; }

# Primer aviso de la entrega
c1=$(curl -s -o /dev/null -w "%{http_code}" --max-time 10 -XPOST localhost:8080/webhooks/paqueteria -H 'Content-Type: application/json' -d @"$DATOS/webhooks/entrega-4001.json")
esperar_ops 4001 entregada 3
# Segundo aviso: el mismo contenido, escrito en una sola línea y con los campos en otro orden
OTRA=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(json.dumps(dict(reversed(list(d.items()))), separators=(',',':')))" "$DATOS/webhooks/entrega-4001.json")
R2=$(curl -s -w "\n%{http_code}" --max-time 10 -XPOST localhost:8080/webhooks/paqueteria -H 'Content-Type: application/json' -d "$OTRA")
sleep 3
[ "$c1" = "202" ] && [ "$(echo "$R2" | tail -1)" = "202" ] && echo "$R2" | hay '"resultado":"repetido"' \
  && si "Los dos avisos contestaron 202, y el segundo se reconoció como repetido aunque viniera escrito distinto" \
  || no "Esperaba 202 y 202 «repetido»; contestó «$c1» y «$(echo "$R2" | tr '\n' ' ')»"
OPS=$(EST "SELECT COUNT(*) FROM operacion WHERE orden='4001' AND momento='entregada'")
INT=$(EST "SELECT COUNT(*) FROM intento i JOIN operacion p ON p.id = i.operacion WHERE p.orden='4001' AND p.momento='entregada'")
HU=$(EST "SELECT COUNT(DISTINCT huella) FROM operacion WHERE orden='4001' AND momento='entregada' AND huella ~ '^[0-9a-f]{64}$'")
[ "$OPS" = "3" ] && [ "$INT" = "3" ] && [ "$HU" = "1" ] \
  && si "Estado: la entrega tiene 3 operaciones con su huella sha256 y 3 intentos, uno por canal" \
  || no "Estado: esperaba 3 operaciones con huella y 3 intentos; hay $OPS operaciones, $HU huellas y $INT intentos"
N201=$(INFRA logs --since "$T0" api-pedidos 2>/dev/null | grep -c "201 evento llave=orden-4001-entregada ")
N214=$(SOCIO "ls /home/socio/entrada" | grep -c '^214-4001')
[ "$N201" = "1" ] && [ "$N214" = "1" ] && [ "$(SQL "SELECT estatus FROM pedido_cabecera WHERE pedido='4001'")" = "ENTREGADO" ] \
  && si "Destinos: un solo 201 de la entrega en la API, un solo 214 en el socio y el ERP en ENTREGADO" \
  || no "Destinos: esperaba un 201 y un 214; hay $N201 y $N214"

# Un aviso con la misma llave y OTRA guía: no es el mismo mensaje
CONF=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); d['guia']='PAQX779994001'; print(json.dumps(d))" "$DATOS/webhooks/entrega-4001.json")
R3=$(curl -s -w "\n%{http_code}" --max-time 10 -XPOST localhost:8080/webhooks/paqueteria -H 'Content-Type: application/json' -d "$CONF")
sleep 3
[ "$(echo "$R3" | tail -1)" = "409" ] && si "Un aviso con la misma llave y otra guía contestó 409 «conflicto»" \
  || no "Esperaba 409 para el aviso con otra guía y contestó: $(echo "$R3" | tr '\n' ' ')"
FILA=$(EST "SELECT llave, cuerpo->>'guia', (huella_guardada <> huella_nueva) FROM conflicto WHERE orden='4001'")
[ "$FILA" = "$(printf 'orden-4001-entregada\tPAQX779994001\tt')" ] \
  && si "Estado: el conflicto quedó en su tabla, con la llave, lo que llegó y las dos huellas distintas" \
  || no "Estado: esperaba una fila en conflicto para orden-4001-entregada; hay «${FILA:-nada}»"
SERV logs orden-router 2>/dev/null | hay "WARN.*CONFLICTO orden-4001-entregada" \
  && si "Log: el router avisó el conflicto con un WARN" || no "Log: no hay un WARN «CONFLICTO orden-4001-entregada» en el router"
INT=$(EST "SELECT COUNT(*) FROM intento i JOIN operacion p ON p.id = i.operacion WHERE p.orden='4001' AND p.momento='entregada'")
[ "$(EST "SELECT datos->'entrega'->>'guia' FROM orden WHERE orden='4001'")" = "PAQX770004001" ] && [ "$INT" = "3" ] \
  && [ "$(CAMPO 4001 guia)" = "PAQX770004001" ] \
  && si "Nada se pisó: la orden guarda la guía original, sigue habiendo 3 intentos y la API tiene la guía con la que salió" \
  || no "El conflicto pisó algo: la orden tiene la guía «$(EST "SELECT datos->'entrega'->>'guia' FROM orden WHERE orden='4001'")» y hay $INT intentos"
apagar
exit $ok
