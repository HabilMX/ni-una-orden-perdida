#!/usr/bin/env bash
# Comprueba la lección 09: la misma orden llega a los TRES destinos (API, ERP y SFTP del socio),
# y el hilo de correlación llega a los dos que lo guardan (API y ERP).
# Uso: ./verifica [mio|solucion]   (por omisión, mio). Necesita el ambiente de la 00 arriba.
set -uo pipefail
cd "$(dirname "$0")"
RAIZ="$(cd ../.. && pwd)"
DONDE="${1:-mio}"
[ -d "$DONDE" ] || { echo "❌ No existe $DONDE/. Copia inicio/ a mio/ primero."; exit 1; }
ok=0; si() { echo "✅ $1"; }; no() { echo "❌ $1"; ok=1; }
INFRA() { docker compose -f "$RAIZ/infra/compose.yaml" "$@"; }
SQL() { INFRA exec -T erp mariadb -uintegracion -p"${ERP_CLAVE:-practica}" erp -N -e "$1" 2>/dev/null; }
SOCIO() { INFRA exec -T socio-sftp sh -c "$1" 2>/dev/null; }
SERV() { DONDE="$DONDE" docker compose -f compose.yaml "$@"; }
apagar() { SERV down >/dev/null 2>&1; }

# Los tres destinos empiezan limpios
INFRA restart api-pedidos >/dev/null 2>&1
INFRA up -d --wait api-pedidos >/dev/null 2>&1 || { no "La API no levantó: ¿corriste la 00?"; exit 1; }
SQL "DELETE FROM pedido_detalle; DELETE FROM pedido_cabecera;" || { no "No pude hablar con el ERP: ¿corriste la 00?"; exit 1; }
[ "$(SQL "SELECT COUNT(*) FROM information_schema.columns WHERE table_schema='erp' AND table_name='pedido_cabecera' AND column_name='correlacion'")" = "1" ] \
  || { no "Tu ERP no tiene la columna correlacion. Recréalo: docker compose -f infra/compose.yaml up -d --wait --force-recreate -V erp"; exit 1; }
SOCIO "rm -f /home/socio/entrada/*" || { no "No pude hablar con el SFTP del socio: ¿corriste la 00?"; exit 1; }
(cd "$DONDE/int-edi" && "$RAIZ/herramientas/confiar-en-socio" >/dev/null) || { no "No pude anotar la llave del socio"; exit 1; }
API=$(INFRA ps -q api-pedidos); DESDE=$(docker inspect -f '{{.State.StartedAt}}' "$API")

apagar
if curl -s -o /dev/null --max-time 2 localhost:8080; then
  no "El puerto 8080 está ocupado: apaga lo que dejaste corriendo (Ctrl+C o «docker compose … down») y vuelve a intentar"; exit 1
fi
SERV up -d >/dev/null 2>&1 || { no "No pude levantar los servicios de la lección"; apagar; exit 1; }
LISTOS() { SERV logs 2>/dev/null | grep -cE 'Started (orden-router|int-rest|int-bd|int-edi) '; }
for i in $(seq 1 90); do [ "$(LISTOS)" -ge 4 ] && break; sleep 2; done
[ "$(LISTOS)" -ge 4 ] && si "Arrancaron el router y los tres canales" \
  || { no "No arrancaron los cuatro servicios. Esto dijeron:"; SERV logs 2>/dev/null | grep -E "ERROR|Exception" | head -10; apagar; exit 1; }

HILO="tienda-$(date +%s)"
R=$(curl -s -w "\n%{http_code}" -XPOST localhost:8080/ordenes -H 'Content-Type: application/json' \
      -H "X-Correlation-Id: $HILO" -d @"$RAIZ/datos/ordenes/orden-1003.json")
CANALES=$(echo "$R" | head -1 | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
    print(" ".join(sorted(c["canal"] + "=" + str(c["codigo"]) for c in d["canales"])))
except Exception:
    print("")' 2>/dev/null)
if [ "$(echo "$R" | tail -1)" = "200" ] && echo "$CANALES" | grep -qE "^api=20[01] erp=200 socio=200$"; then
  si "La tienda mandó la 1003 y el router contestó lo que dijo cada canal: $CANALES"
else
  no "El router no contestó que los tres canales la recibieron. Contestó: $(echo "$R" | tr '\n' ' ')"
fi
sleep 2   # el último canal puede terminar un instante después de que su log aparece

docker logs --since "$DESDE" "$API" 2>&1 | grep -q "201 llave=1003 pedido=1003 correlacion=$HILO" \
  && si "API: tiene el pedido 1003, con el hilo $HILO" || no "API: no registró la 1003 con el hilo $HILO"
FILA=$(SQL "SELECT estatus, correlacion FROM pedido_cabecera WHERE pedido='1003'")
[ "$FILA" = "$(printf 'REGISTRADO\t%s' "$HILO")" ] && si "ERP: tiene el pedido 1003 REGISTRADO, con el hilo $HILO" \
  || no "ERP: esperaba «REGISTRADO $HILO» y tiene «${FILA:-nada}»"
SOCIO "cat /home/socio/entrada/850-1003.edi" | grep -q "^BEG\*00\*SA\*1003\*" \
  && si "Socio: tiene el 850 de la 1003 en su SFTP" || no "Socio: no está el 850 de la 1003 (hay: $(SOCIO 'ls /home/socio/entrada' | tr '\n' ' '))"
SERV logs int-edi 2>/dev/null | grep -q "orden 1003 en el SFTP del socio correlacion=$HILO" \
  && si "int-edi anotó el hilo (al socio no se le manda: con él, el hilo es el número de control del X12)" \
  || no "int-edi no anotó el hilo $HILO"
apagar
exit $ok
