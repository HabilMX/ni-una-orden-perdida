#!/usr/bin/env bash
# Comprueba la lección 19: la API está apagada cuando la tienda manda la 4001 y la bodega su embarque. El router
# reintenta en el lugar, con espera creciente: cada intento queda en la base con su hora. Cuando la API vuelve, la
# orden y su embarque le llegan, y en ese orden. Los otros canales no se repiten: a ellos les fue bien a la primera.
# Uso: ./verifica [mio|solucion]   (por omisión, mio). Necesita el ambiente de la 00 arriba.
set -uo pipefail
cd "$(dirname "$0")"
RAIZ="$(cd ../.. && pwd)"
DONDE="${1:-mio}"
[ -d "$DONDE" ] || { echo "❌ No existe $DONDE/. Copia inicio/ a mio/ primero."; exit 1; }
hay() { grep "$@" >/dev/null; }   # grep sin -q: con pipefail, -q corta la tubería y da falsos rojos
ok=0; si() { echo "✅ $1"; }; no() { echo "❌ $1"; ok=1; }
INFRA() { docker compose -f "$RAIZ/infra/compose.yaml" "$@"; }
SQL() { INFRA exec -T erp mariadb -uintegracion -p"${ERP_CLAVE:-practica}" erp -N -e "$1" 2>/dev/null; }
EST() { INFRA exec -T estado psql -U router -d estado -tAF $'\t' -c "$1" 2>/dev/null; }
SOCIO() { INFRA exec -T socio-sftp sh -c "$1" 2>/dev/null; }
SERV() { DONDE="$DONDE" docker compose -f compose.yaml "$@"; }
apagar() { SERV down >/dev/null 2>&1; }
CAMPO() { curl -s "localhost:8081/pedidos/$1" | python3 -c "import sys,json; print(json.load(sys.stdin).get('$2'))" 2>/dev/null; }
DATOS="$RAIZ/datos"
# Cuántas operaciones de una orden y un momento ya tienen desenlace (ni pendientes ni estacionadas)
TERMINADAS() { EST "SELECT COUNT(*) FROM operacion WHERE orden='$1' AND momento='$2' AND estado NOT IN ('pendiente','estacionada')"; }
ESTACIONADAS() { EST "SELECT COUNT(*) FROM operacion WHERE orden='$1' AND momento='$2' AND estado = 'estacionada'"; }
esperar_est() { for i in $(seq 1 20); do [ "$(ESTACIONADAS "$1" "$2")" -ge "$3" ] && return 0; sleep 1; done; return 1; }
esperar_ops() { for i in $(seq 1 40); do [ "$(TERMINADAS "$1" "$2")" -ge "$3" ] && return 0; sleep 2; done; return 1; }

# Todo empieza limpio: los destinos y la base de estado
INFRA restart api-pedidos >/dev/null 2>&1
INFRA up -d --wait api-pedidos erp estado >/dev/null 2>&1 || { no "El ambiente no levantó: ¿corriste la 00?"; exit 1; }
SQL "DELETE FROM entrega; DELETE FROM embarque; DELETE FROM pedido_detalle; DELETE FROM pedido_cabecera;" || { no "No pude hablar con el ERP"; exit 1; }
[ "$(EST "SELECT COUNT(*) FROM information_schema.columns WHERE table_name='operacion' AND column_name='correlacion'")" = "1" ] \
  && [ "$(EST "SELECT COUNT(*) FROM pg_class WHERE relname='numero_control_seq'")" = "1" ] \
  || { no "A la base de estado le falta la secuencia numero_control_seq o la columna correlacion. Recréala: docker compose -f infra/compose.yaml up -d --wait --force-recreate -V estado"; exit 1; }
EST "TRUNCATE conflicto, intento, operacion, orden RESTART IDENTITY CASCADE" >/dev/null || { no "No pude limpiar la base de estado"; exit 1; }
SOCIO "rm -f /home/socio/entrada/*" || { no "No pude hablar con el SFTP del socio"; exit 1; }
(cd "$DONDE/int-edi" && "$RAIZ/herramientas/confiar-en-socio" >/dev/null) || { no "No pude anotar la llave del socio"; exit 1; }
[ "$DONDE" = "mio" ] || trap 'rm -f "$DONDE/int-edi/known_hosts"' EXIT
rm -rf buzon; mkdir -p buzon

apagar
if curl -s -o /dev/null --max-time 2 localhost:8080; then
  no "El puerto 8080 está ocupado: apaga lo que dejaste corriendo (Ctrl+C o «docker compose … down») y vuelve a intentar"; exit 1
fi
SERV up -d >/dev/null 2>&1 || { no "No pude levantar los servicios de la lección"; apagar; exit 1; }
RUTAS="intentar|reconocer|recibir-momento|contestar-reconocido|barrido-http|barrido|decidir|webhook-paqueteria|int-rest-entrega|int-bd-entrega|int-edi-entrega|orden-router|embarque-router|hilo|contestar-y-repartir|no-existe|canales|cargar-orden|guardar-orden|guardar-momento|repartir|enviar|int-rest|int-bd|int-edi|int-rest-embarque|int-bd-embarque|int-edi-embarque|sondeo-bodega"
LISTOS() { SERV logs 2>/dev/null | grep -cE "Started ($RUTAS) "; }
for i in $(seq 1 90); do [ "$(LISTOS)" -ge 29 ] && break; sleep 2; done
[ "$(LISTOS)" -ge 29 ] && si "Arrancaron el router (con sus reintentos), los tres canales y el sondeo" \
  || { no "No arrancaron todas las rutas. Esto dijeron:"; SERV logs 2>/dev/null | grep -E "ERROR|Exception" | head -10; apagar; exit 1; }

# Se apaga la API: el destino no contesta. Pase lo que pase, al salir se vuelve a prender.
trap 'INFRA start api-pedidos >/dev/null 2>&1; [ "$DONDE" = "mio" ] || rm -f "$DONDE/int-edi/known_hosts"' EXIT
INFRA stop api-pedidos >/dev/null 2>&1
c=$(curl -s -o /dev/null -w "%{http_code}" --max-time 10 -XPOST localhost:8080/ordenes -H 'Content-Type: application/json' -d @"$DATOS/ordenes/tramo-2/orden-4001.json")
python3 -c "import json,sys; e=json.load(open(sys.argv[1])); json.dump({'lote':'9001','bodega':'B-NORTE','embarques':[e]}, open('buzon/lote-bodega-9001.json','w'))" "$DATOS/embarques/embarque-4001.json"
[ "$c" = "202" ] && si "Con la API apagada, la tienda recibió su 202: lo suyo quedó guardado" || no "Con la API apagada, la tienda recibió «$c»"
sleep 6
T0=$(date -u +%Y-%m-%dT%H:%M:%SZ)
INFRA start api-pedidos >/dev/null 2>&1; INFRA up -d --wait api-pedidos >/dev/null 2>&1
for i in $(seq 1 45); do [ "$(TERMINADAS 4001 embarcada)" -ge 3 ] && break; sleep 2; done

# Los intentos del canal rest para la orden creada: varios, el último aceptado, cada espera más larga que la anterior
FILAS=$(EST "SELECT i.n, i.desenlace, EXTRACT(EPOCH FROM i.inicio - lag(i.inicio) OVER (ORDER BY i.n)) FROM intento i JOIN operacion p ON p.id = i.operacion WHERE p.orden='4001' AND p.momento='creada' AND p.canal='rest' ORDER BY i.n")
RES=$(printf '%s\n' "$FILAS" | python3 -c "
import sys
f=[l.split('\t') for l in sys.stdin.read().split('\n') if l.strip()]
d=[x[1] for x in f]; e=[float(x[2]) for x in f[1:] if x[2]]
ok=len(f)>=3 and d[-1]=='aceptada' and all(x=='no_se_sabe' for x in d[:-1]) and all(b>a for a,b in zip(e,e[1:])) and e[0]>=0.5
print(('si' if ok else 'no')+' '+str(len(f))+' intentos; esperas '+' '.join('%.1fs'%x for x in e)+'; desenlaces '+' '.join(d))")
[ "${RES%% *}" = "si" ] && si "Estado: el canal rest reintentó en el lugar: ${RES#* }" \
  || no "Estado: esperaba 3 o más intentos de rest, cada espera más larga, el último aceptado; hay ${RES#* }"
OTROS=$(EST "SELECT string_agg(p.canal || '=' || p.estado || '/' || (SELECT COUNT(*) FROM intento i WHERE i.operacion = p.id), ' ' ORDER BY p.canal) FROM operacion p WHERE p.orden='4001' AND p.momento='creada' AND p.canal <> 'rest'")
[ "$OTROS" = "bd=aceptada/1 edi=aceptada/1" ] && si "Estado: el ERP y el socio no se repitieron: aceptados al primer intento ($OTROS)" \
  || no "Estado: el ERP y el socio quedaron «${OTROS:-nada}» (estado/intentos)"

# El destino recibió los dos momentos, y en orden: primero la orden, después su embarque
LOGAPI=$(INFRA logs --since "$T0" api-pedidos 2>/dev/null)
ORDEN=$(printf '%s\n' "$LOGAPI" | grep -n "201 llave=4001 " | head -1 | cut -d: -f1)
EMB=$(printf '%s\n' "$LOGAPI" | grep -n "201 evento llave=orden-4001-embarcada " | head -1 | cut -d: -f1)
[ -n "$ORDEN" ] && [ -n "$EMB" ] && [ "$ORDEN" -lt "$EMB" ] && [ "$(CAMPO 4001 estatus)" = "EMBARCADO" ] \
  && si "API: recibió la orden y después su embarque, y la 4001 quedó EMBARCADO" \
  || no "API: esperaba la orden antes que el embarque; renglón de la orden «${ORDEN:-no llegó}», del embarque «${EMB:-no llegó}», estatus «$(CAMPO 4001 estatus)»"
[ "$(SQL "SELECT estatus FROM pedido_cabecera WHERE pedido='4001'")" = "EMBARCADO" ] \
  && si "ERP: la 4001 está EMBARCADO" || no "ERP: la 4001 está «$(SQL "SELECT estatus FROM pedido_cabecera WHERE pedido='4001'")»"
apagar
exit $ok
