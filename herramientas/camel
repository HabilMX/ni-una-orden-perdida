#!/usr/bin/env bash
# Corre la CLI de Camel dentro de su imagen oficial, sobre la carpeta en la que estás.
# Así no instalas Java ni Camel: solo Docker.
#
#   ../../herramientas/camel run mi-ruta.camel.yaml
#
# La versión está fija a propósito: todo el curso usa la misma (Camel 4.22.1, de soporte largo).
set -euo pipefail
IMAGEN="apache/camel-jbang:4.22.1"
# --network: para que la ruta alcance a los destinos del ambiente por su nombre (api-pedidos, erp…).
# El volumen de .m2 guarda lo que Camel descarga, para no bajarlo en cada corrida.
TTY=$([ -t 0 ] && echo "-it" || echo "-i")
# El puerto 8080 se abre solo si la ruta recibe por HTTP (platform-http). Las demás no lo necesitan, y así
# no chocan con otra ruta que ya lo esté usando.
PUERTO=()
if [ "${1:-}" = "run" ] && grep -qs "platform-http" ./*.camel.yaml; then
  PUERTO=(-p "${CAMEL_PUERTO:-8080}:8080")
fi
# Si la carpeta tiene dependencias.txt, Camel descarga esas piezas extra (por ejemplo, el driver de una base).
# Una por renglón, en la forma grupo:artefacto:versión; los renglones con # son comentarios.
EXTRA=()
if [ "${1:-}" = "run" ] && [ -f dependencias.txt ]; then
  DEPS=$(grep -vE '^\s*(#|$)' dependencias.txt | paste -sd, -)
  [ -n "$DEPS" ] && EXTRA=(--dep="$DEPS")
fi
# El contenedor arranca como root solo para acomodar permisos y luego corre Camel con el MISMO usuario que es
# dueño de la carpeta en la que estás. Sin esto, en Linux, Camel no puede escribir en tu carpeta si tu usuario no
# tiene el número 1000. El detalle está en herramientas/correr-como-el-dueno.
RAIZ="$(cd "$(dirname "$0")/.." && pwd)"
exec docker run --rm $TTY \
  --network "${CAMEL_RED:-practica-retail_default}" \
  -v "$PWD":/work -w /work \
  -v practica-retail-m2:/home/ubuntu/.m2 \
  -v "$RAIZ/herramientas/correr-como-el-dueno":/practica/arranque:ro \
  --user root --entrypoint sh \
  ${PUERTO[@]+"${PUERTO[@]}"} \
  "$IMAGEN" /practica/arranque "$@" ${EXTRA[@]+"${EXTRA[@]}"}
